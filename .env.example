# ===========================================================================
#  SupportWizard NetKit — environment TEMPLATE
#
#  >>> THIS FILE IS COMMITTED TO GIT. NEVER PUT REAL VALUES IN IT. <<<
#
#  It is a template and nothing more: the application reads `.env`, never
#  this file, so anything filled in here has no effect at runtime and simply
#  waits to be pushed to GitHub in plaintext.
#
#    cp .env.example .env      # then edit .env, which is gitignored
#
#  On Plesk, prefer Websites & Domains → Node.js → Custom environment
#  variables. Those take precedence over `.env` and are not on disk in the
#  deployment directory at all.
#
#  `npm run check:secrets` fails if a credential ends up in here.
# ===========================================================================

# ---- Core -----------------------------------------------------------------
NODE_ENV=production
# Passenger sets PORT itself on Plesk; only needed when running directly.
PORT=3000

# Signing key for session cookies. REQUIRED in production.
# Generate with:  openssl rand -base64 48
SESSION_SECRET=

# Where users, settings and the audit log are written -- the only state that
# cannot be rebuilt from Git.
#
# REQUIRED, and it must be an ABSOLUTE path outside the deployment directory.
# A relative path lands inside the Git working tree, where the next deploy
# deletes every user account. The app refuses to start in production without
# this set.
DATA_DIR=

# Where `backup-data.sh` writes archives. Absolute, and outside the
# deployment directory for the same reason.
BACKUP_DIR=

# Where the built SPA lives. Leave blank to auto-detect ./public.
PUBLIC_DIR=


# Cache lifetime for lookups, seconds. Zen's fair-use policy makes this
# important: it is what stops repeat checks hitting their quota.
CACHE_TTL_SECONDS=900
REQUEST_TIMEOUT_MS=12000
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120

# Only needed if the SPA is served from a different origin to the API.
CORS_ORIGINS=

# ---- First administrator --------------------------------------------------
# Seeded once, on first start, if no admin exists. If ADMIN_PASSWORD is left
# blank a strong one is generated and printed to the application log, and must
# be changed at first sign-in.
ADMIN_EMAIL=joe@supportwizard.net
ADMIN_NAME=Joe Kane
ADMIN_PASSWORD=

# ---- Zen Internet — Indirect API -----------------------------------------
# From your Zen account manager. Auth is OAuth2 client credentials.
ZEN_CLIENT_ID=
ZEN_CLIENT_SECRET=
ZEN_TOKEN_URL=https://id.zen.co.uk/connect/token
ZEN_SELF_SERVICE_BASE_URL=https://gateway.api.indirect.zen.co.uk/self-service
ZEN_ASSURANCE_BASE_URL=https://gateway.api.indirect.zen.co.uk/assurance

# Scopes your credentials are granted. Remove any you do not have — the app
# will not attempt a scope that is not listed.
ZEN_SCOPES=indirect-availability,indirect-service,indirect-order,indirect-placeorder,indirect-broadbandconnection,indirect-diagnostics,indirect-faults,indirect-cdr,indirect-quote,indirect-customerengagement,indirect-changeservice

# ---- Ordnance Survey Places ----------------------------------------------
# The only source that resolves a bare UPRN to an address, and the
# authoritative address/UPRN search. https://osdatahub.os.uk/plans
OS_PLACES_API_KEY=
OS_PLACES_BASE_URL=https://api.os.uk/search/places/v1

# ---- postcodes.io ---------------------------------------------------------
# Free, no key. Supplies real post town, ward, constituency and coordinates.
POSTCODES_IO_ENABLED=true
POSTCODES_IO_BASE_URL=https://api.postcodes.io

# ---- Resend (transactional email) ----------------------------------------
# Email two-factor authentication only becomes available once a delivery test
# passes in the admin portal. https://resend.com/docs
RESEND_API_KEY=
RESEND_FROM_EMAIL=no-reply@supportwizard.net
RESEND_FROM_NAME=SupportWizard NetKit

# ---- BT developer products -----------------------------------------------
# https://developer.bt.com/products — request access per product. BT does not
# publish base URLs or the auth scheme without an account, so set them from
# the credentials pack you are issued.
BT_TOKEN_URL=

# "Verifies customer phone connection to EE's network"
BT_HOME_NETWORK_KEY=
BT_HOME_NETWORK_BASE_URL=
BT_HOME_NETWORK_CLIENT_ID=
BT_HOME_NETWORK_CLIENT_SECRET=

# "Retrieves the IMEI for the associated MSISDN"
BT_IMEI_LOOKUP_KEY=
BT_IMEI_LOOKUP_BASE_URL=
BT_IMEI_LOOKUP_CLIENT_ID=
BT_IMEI_LOOKUP_CLIENT_SECRET=

# Footfall and visitor catchments — London only
BT_LOCATION_INSIGHTS_KEY=
BT_LOCATION_INSIGHTS_BASE_URL=
BT_LOCATION_INSIGHTS_CLIENT_ID=
BT_LOCATION_INSIGHTS_CLIENT_SECRET=

# ---- Jola SIM Portal -----------------------------------------------------
# Business SIM estate. Note Zen's /api/cellular/* endpoints are already
# Jola-backed, so this is only worth wiring up for SIMs held directly with
# Jola.
#
# The API uses HTTP BASIC auth and needs BOTH halves -- a key on its own is
# not a credential here, and sending it as a Bearer token is what produced
# 401s. Leave the base URL blank to use Jola's production host.
JOLA_API_KEY=
JOLA_SECRET_KEY=
JOLA_BASE_URL=

# ---- Ordering safety switch ----------------------------------------------
# Placing real orders is disabled unless this is explicitly true. Ordering
# spends money and books engineer appointments, so it does not simply inherit
# the credentials that read data.
#
# This is one of TWO locks. The other is the switch in Admin portal →
# Ordering & limits, which is off by default and has its own type-to-confirm.
# Both must be open before an order can be sent, and each order additionally
# needs the installation address retyped by hand.
ZEN_ALLOW_ORDERING=false


# ---- Ofcom mobile coverage ------------------------------------------------
# Turns the coverage panel from modelled into Ofcom's published prediction.
# Free, no account.
#
# NOTE ON RESOLUTION. Ofcom do not publish mobile coverage per postcode.
# The mobile files are per parliamentary constituency (pcon), per local or
# unitary authority (laua), per devolved constituency (devcon) and per
# nation. Postcode-unit files exist only for FIXED BROADBAND. Point this at
# a pcon or laua CSV: postcodes.io resolves the postcode to its area and the
# figures are labelled in the UI as area-level, not per-premises.
#
# POINT THIS AT THE FOLDER THE ZIP EXTRACTS TO, not a single CSV. The zip
# holds the constituency, local-authority and devolved-constituency files
# together and all of them are indexed, finest area first — asking somebody
# to pick one and rename it is how the wrong one ends up configured. A single
# CSV still works.
#
# Column names are interpreted rather than hard-coded, so a new release keeps
# working, and a postcode-keyed file is used directly if Ofcom ever publish
# one. Ofcom's own shape is understood: `4G_prem_in_3` means "3 of the 4
# networks give indoor 4G to this percentage of premises". That counts
# networks rather than naming them, so the UI shows it in amber and says it
# cannot answer "does EE work at this door".
# https://www.ofcom.org.uk/phones-and-broadband/coverage-and-speeds/data-downloads2
OFCOM_DATASET_PATH=

# ---- Zendesk Support ------------------------------------------------------
# The ticket side of a fault. Three things:
#
#   · a PRIVATE note on the customer's ticket recording what was sent to the
#     supplier and what came back, so the next engineer to open it does not
#     repeat the same test and the customer never reads raw supplier output;
#   · the customer's own contacts, so the site contact handed to an engineer
#     is picked from a list rather than typed from memory;
#   · the one PUBLIC message — that a visit is booked, with the 24 hours'
#     notice and the missed-appointment charge stated up front.
#
# ZENDESK_EMAIL is an agent account and ZENDESK_API_TOKEN is an API token from
# Admin Centre → Apps and integrations → APIs → Zendesk API. Auth is Basic
# with "<email>/token" as the username, which is Zendesk's own scheme.
#
# The token needs to see tickets, users and organisations, and to comment. An
# agent with restricted access will read some tickets and not others, which
# shows up as "Zendesk has no ticket N" for tickets that plainly exist.
# It also reads a client's TERMS off their Zendesk organisation, which is
# what drives the pay-as-you-go check and the on-stop reminder. Nobody agrees
# where to put this, so three places are read in order: an organisation field
# whose name mentions terms/billing/contract/support/account/status, then the
# tags, then the notes. The first recognisable value wins and the text it read
# is kept, so a wrong reading can be traced rather than argued about.
#
# An unrecognised value reads as "terms not recorded", never as "on support" —
# assuming a contract exists is the expensive direction to be wrong in.
ZENDESK_SUBDOMAIN=
ZENDESK_EMAIL=
ZENDESK_API_TOKEN=

# ---- OpenCelliD — nearest cell sites --------------------------------------
# FREE token from https://opencellid.org/ (register, then API Access).
#
# Gives the cell sites near a premises with a distance each, three per
# network. This is the honest counterweight to coverage published per
# constituency: "the nearest EE site is 4.2 km away across a hill" explains
# what an area-level figure cannot.
#
# OpenCelliD call the value a TOKEN, so `OPENCELLID` and `OPENCELLID_TOKEN`
# are both accepted as well as the name below — reading all three is one line
# and saves somebody staring at a status board that says "not connected" with
# a perfectly good token next to it.
OPENCELLID_API_KEY=

# How far around the premises to look. Clamped to 500 m – 20 km.
OPENCELLID_RADIUS_METRES=4000

# ---- Ofcom Connected Nations Broadband API -------------------------------
# FREE with a developer account at https://api.ofcom.org.uk/signup/ —
# subscribe to "Broadband Coverage (Basic)": 100 calls/minute, 50,000 requests
# a month. The key is on your Profile page as the Primary key.
#
# Gives PER-PREMISES predicted speeds keyed by UPRN — the only free source
# that answers "what can this address actually get". Useful as an independent
# check on a wholesale estimate, and as the honest free answer to "is there
# gigabit here" before any wholesale account is connected.
#
# It names NO OPERATOR. Ofcom withhold the per-provider split as commercially
# confidential and their schema has no operator field at all, so it can never
# tell you Community Fibre or G.Network serves an address. That is why it
# appears beside the availability table rather than as rows in it.
#
# The MOBILE API is not on this portal — api.ofcom.org.uk sells the two
# broadband products and nothing else. Ofcom's mobile coverage API lives on a
# separate platform; until that access comes through, mobile coverage comes
# from OFCOM_DATASET_PATH above.
OFCOM_BROADBAND_API_KEY=
OFCOM_BROADBAND_BASE_URL=https://api-proxy.ofcom.org.uk/broadband

# FAILOVER for the API above: the Connected Nations FIXED-BROADBAND release.
#
# Unlike mobile, Ofcom DO publish fixed broadband per postcode unit, so this
# is a real per-postcode answer rather than an area average — gigabit, full
# fibre, superfast and ultrafast availability, the share of premises below the
# 10 Mb universal service obligation, and maximum speeds.
#
# Point it at the folder the fixed-postcode zip extracts to. It is used ONLY
# when the API has no key or does not answer: same publisher, and the API is
# months fresher. Everything from the file is stamped as a dated snapshot and
# shown in amber, so a file months old can never read as a current check.
#
# Column names are matched on the words that carry the meaning, because Ofcom
# rename them between releases. A column that cannot be understood is left
# out rather than guessed at.
# https://www.ofcom.org.uk/phones-and-broadband/coverage-and-speeds/data-downloads2
OFCOM_BROADBAND_DATASET_PATH=

# ---- Recovery supervisor --------------------------------------------------
# Probes every integration on an interval and tries to fix what it can:
# re-mint an expired token, drop a poisoned cache, reload a dataset. A run of
# failures opens a circuit breaker so lookups skip the dead upstream rather
# than waiting for its timeout.
SUPERVISOR_ENABLED=true
# Minimum 60. Five minutes catches a token expiry before a user does.
SUPERVISOR_INTERVAL_SECONDS=300

# Runs the full self-test at startup and logs the result, so a broken
# deployment announces itself rather than waiting to be discovered.
SELFTEST_ON_BOOT=true

# ---- Companies House ------------------------------------------------------
# Free with a registration key. Adds business context to a premises: company
# status, incorporation date, SIC codes, overdue filings. The "Who is here"
# tab on a site report uses it — a business fault reads differently when the
# company went into liquidation last month.
# https://developer.company-information.service.gov.uk/
COMPANIES_HOUSE_API_KEY=
COMPANIES_HOUSE_BASE_URL=https://api.company-information.service.gov.uk

# ---- Fair-use rationing ---------------------------------------------------
# Premises lookups per user per day. Zen's availability quota is per account
# rather than per user, so one person working through a list of postcodes can
# spend everyone else's allowance. Repeat looks at a premises already checked
# today are free. 0 removes the limit.
AVAILABILITY_DAILY_BUDGET=250

# The per-user daily ORDER cap is not here — it is in the admin portal, so it
# can be changed without a deploy. It defaults to 3.

# ---- Escalation -----------------------------------------------------------
# How long an integration must keep failing before the admins are emailed.
# Recovery handles the transient cases; this is for the ones it cannot.
# Minimum 5. Requires a verified Resend key, or nothing is sent.
SUPERVISOR_ESCALATE_AFTER_MINUTES=60

# ---- thinkbroadband — alt-net and cable coverage --------------------------
# The gap Zen cannot fill: Zen answers authoritatively for Openreach and
# nothing else, so CityFibre, Virgin Media, Community Fibre and G.Network are
# invisible without this. thinkbroadband aggregate availability across the
# alt-nets and cable, keyed by postcode and UPRN.
#
# It is a DATA licence, not a wholesale agreement — you get to see who could
# serve a premises, not to order it. Priced on enquiry; contact them via the
# page below. Until a key is present the panel shows demo footprint data,
# clearly labelled as unchecked.
# https://www.thinkbroadband.com/broadband-availability-api
THINKBROADBAND_API_KEY=

# Only change these if thinkbroadband tell you to — the base URL and path are
# configurable because they publish the specification to licensees only.
THINKBROADBAND_BASE_URL=https://api.thinkbroadband.com
THINKBROADBAND_AVAILABILITY_PATH=/availability
# Set true if your licence keys the query string rather than a header.
THINKBROADBAND_KEY_IN_QUERY=false

# ---- Giacom (formerly Digital Wholesale Solutions) -----------------------
# The second wholesale supplier. Zen answers for Openreach and nothing else;
# Giacom carry BT Wholesale, CityFibre, TalkTalk Business, Virgin Media
# Business and Sky Business, so the same premises can be sellable through both
# accounts at different prices. Their answers merge into the site report as
# separate rows tagged by supplier.
#
# OAuth 2.0 client credentials. Defaults below are Giacom's own published
# production servers, so normally only the credentials are needed.
# https://docs.integrations.giacom.com/
GIACOM_CLIENT_ID=
GIACOM_CLIENT_SECRET=

# `uat` switches both hosts to Giacom's UAT environment, for proving the
# integration before it touches the production account.
GIACOM_ENVIRONMENT=production

# Scopes are granted individually by Giacom, so a working credential can still
# be refused one of them. The admin board probes each separately. Trim this
# list to what your tenant actually has.
GIACOM_SCOPES=integrations/serviceInventory.read,integrations/serviceCatalogue.read,integrations/resourceInventory.read,integrations/address.manage,integrations/serviceQualification.read,integrations/serviceQualification.submit

# TMF645 ServiceQualification — the per-address serviceability check.
#
# LEAVE THIS BLANK until Giacom confirm the path. The scope is in their
# published OAuth list but no path for it appears in their public OpenAPI
# document, so it is documented per tenant. Guessing it would produce
# confident 404s that look like "no coverage", which is the worst possible
# failure for this screen. Until it is set, the integration reads the service
# inventory and catalogue only and never claims availability.
GIACOM_QUALIFICATION_PATH=

# Only override these if Giacom tell you to.
GIACOM_BASE_URL=
GIACOM_TOKEN_URL=
