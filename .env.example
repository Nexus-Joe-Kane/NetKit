# ===========================================================================
#  SupportWizard NetKit — environment
#
#  Copy to `.env` and fill in. NEVER commit `.env` — it is gitignored.
#  On Plesk, set these under Websites & Domains → Node.js → Custom
#  environment variables (they take precedence over this file).
# ===========================================================================

# ---- Core -----------------------------------------------------------------
NODE_ENV=production
# Passenger sets PORT itself on Plesk; only needed when running directly.
PORT=3000

# Signing key for session cookies. REQUIRED in production.
# Generate with:  openssl rand -base64 48
SESSION_SECRET=

# Where users, settings and the audit log are written. Must persist across
# deploys and be readable only by the app user.
DATA_DIR=data

# Where the built SPA lives. Leave blank to auto-detect ./public.
PUBLIC_DIR=

# auto — live where credentials exist, demo data elsewhere (recommended)
# live — never fall back to demo data; surface the error instead
# mock — always use demo data (useful for training and screenshots)
DATA_MODE=auto

# Cache lifetime for lookups, seconds. Zen's fair-use policy makes this
# important: it is what stops repeat checks hitting their quota.
CACHE_TTL_SECONDS=900
REQUEST_TIMEOUT_MS=12000
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120

# Only needed if the SPA is served from a different origin to the API.
CORS_ORIGINS=

# ---- First administrator --------------------------------------------------
# Seeded once, on first start, if no admin exists. If ADMIN_PASSWORD is left
# blank a strong one is generated and printed to the application log, and must
# be changed at first sign-in.
ADMIN_EMAIL=joe@supportwizard.net
ADMIN_NAME=Joe Kane
ADMIN_PASSWORD=

# ---- Zen Internet — Indirect API -----------------------------------------
# From your Zen account manager. Auth is OAuth2 client credentials.
ZEN_CLIENT_ID=
ZEN_CLIENT_SECRET=
ZEN_TOKEN_URL=https://id.zen.co.uk/connect/token
ZEN_SELF_SERVICE_BASE_URL=https://gateway.api.indirect.zen.co.uk/self-service
ZEN_ASSURANCE_BASE_URL=https://gateway.api.indirect.zen.co.uk/assurance

# Scopes your credentials are granted. Remove any you do not have — the app
# will not attempt a scope that is not listed.
ZEN_SCOPES=indirect-availability,indirect-service,indirect-order,indirect-placeorder,indirect-broadbandconnection,indirect-diagnostics,indirect-faults,indirect-cdr,indirect-quote,indirect-customerengagement,indirect-changeservice

# ---- Ordnance Survey Places ----------------------------------------------
# The only source that resolves a bare UPRN to an address, and the
# authoritative address/UPRN search. https://osdatahub.os.uk/plans
OS_PLACES_API_KEY=
OS_PLACES_BASE_URL=https://api.os.uk/search/places/v1

# ---- postcodes.io ---------------------------------------------------------
# Free, no key. Supplies real post town, ward, constituency and coordinates.
POSTCODES_IO_ENABLED=true
POSTCODES_IO_BASE_URL=https://api.postcodes.io

# ---- Resend (transactional email) ----------------------------------------
# Email two-factor authentication only becomes available once a delivery test
# passes in the admin portal. https://resend.com/docs
RESEND_API_KEY=
RESEND_FROM_EMAIL=no-reply@supportwizard.net
RESEND_FROM_NAME=SupportWizard NetKit

# ---- BT developer products -----------------------------------------------
# https://developer.bt.com/products — request access per product. BT does not
# publish base URLs or the auth scheme without an account, so set them from
# the credentials pack you are issued.
BT_TOKEN_URL=

# "Verifies customer phone connection to EE's network"
BT_HOME_NETWORK_KEY=
BT_HOME_NETWORK_BASE_URL=
BT_HOME_NETWORK_CLIENT_ID=
BT_HOME_NETWORK_CLIENT_SECRET=

# "Retrieves the IMEI for the associated MSISDN"
BT_IMEI_LOOKUP_KEY=
BT_IMEI_LOOKUP_BASE_URL=
BT_IMEI_LOOKUP_CLIENT_ID=
BT_IMEI_LOOKUP_CLIENT_SECRET=

# Footfall and visitor catchments — London only
BT_LOCATION_INSIGHTS_KEY=
BT_LOCATION_INSIGHTS_BASE_URL=
BT_LOCATION_INSIGHTS_CLIENT_ID=
BT_LOCATION_INSIGHTS_CLIENT_SECRET=

# ---- Jola Mobile Manager -------------------------------------------------
# Business SIM estate. Note Zen's /api/cellular/* endpoints are already
# Jola-backed, so this may be redundant.
# https://developers.mobilemanager.co.uk/Help
JOLA_BASE_URL=
JOLA_API_KEY=
JOLA_HEALTH_PATH=/api/sims

# ---- Ordering safety switch ----------------------------------------------
# Placing real orders is disabled unless this is explicitly true. Ordering
# spends money and books engineer appointments, so it does not simply inherit
# the credentials that read data.
#
# This is one of TWO locks. The other is the switch in Admin portal →
# Ordering & limits, which is off by default and has its own type-to-confirm.
# Both must be open before an order can be sent, and each order additionally
# needs the installation address retyped by hand.
ZEN_ALLOW_ORDERING=false

# Jola: the endpoint listing the SIM estate, if it differs from the default.
JOLA_SIMS_PATH=/api/sims

# ---- Ofcom mobile coverage ------------------------------------------------
# Turns the coverage panel from modelled into Ofcom's published prediction.
# Free, no account: download the Connected Nations postcode-level mobile
# coverage file and point this at it. Column names are interpreted rather
# than hard-coded, so a new release keeps working.
# https://www.ofcom.org.uk/research-and-data/multi-sector-research/infrastructure-research
OFCOM_DATASET_PATH=

# Optional: only if your account has a live coverage endpoint. The dataset
# above is the dependable route.
OFCOM_API_BASE_URL=
OFCOM_API_KEY=

# ---- Recovery supervisor --------------------------------------------------
# Probes every integration on an interval and tries to fix what it can:
# re-mint an expired token, drop a poisoned cache, reload a dataset. A run of
# failures opens a circuit breaker so lookups skip the dead upstream rather
# than waiting for its timeout.
SUPERVISOR_ENABLED=true
# Minimum 60. Five minutes catches a token expiry before a user does.
SUPERVISOR_INTERVAL_SECONDS=300

# Runs the full self-test at startup and logs the result, so a broken
# deployment announces itself rather than waiting to be discovered.
SELFTEST_ON_BOOT=true

# ---- Companies House ------------------------------------------------------
# Free with a registration key. Adds business context to a premises: company
# status, incorporation date, SIC codes, overdue filings. The "Who is here"
# tab on a site report uses it — a business fault reads differently when the
# company went into liquidation last month.
# https://developer.company-information.service.gov.uk/
COMPANIES_HOUSE_API_KEY=
COMPANIES_HOUSE_BASE_URL=https://api.company-information.service.gov.uk

# ---- Fair-use rationing ---------------------------------------------------
# Premises lookups per user per day. Zen's availability quota is per account
# rather than per user, so one person working through a list of postcodes can
# spend everyone else's allowance. Repeat looks at a premises already checked
# today are free. 0 removes the limit.
AVAILABILITY_DAILY_BUDGET=250

# The per-user daily ORDER cap is not here — it is in the admin portal, so it
# can be changed without a deploy. It defaults to 3.

# ---- Escalation -----------------------------------------------------------
# How long an integration must keep failing before the admins are emailed.
# Recovery handles the transient cases; this is for the ones it cannot.
# Minimum 5. Requires a verified Resend key, or nothing is sent.
SUPERVISOR_ESCALATE_AFTER_MINUTES=60

# ---- thinkbroadband — alt-net and cable coverage --------------------------
# The gap Zen cannot fill: Zen answers authoritatively for Openreach and
# nothing else, so CityFibre, Virgin Media, Community Fibre and G.Network are
# invisible without this. thinkbroadband aggregate availability across the
# alt-nets and cable, keyed by postcode and UPRN.
#
# It is a DATA licence, not a wholesale agreement — you get to see who could
# serve a premises, not to order it. Priced on enquiry; contact them via the
# page below. Until a key is present the panel shows demo footprint data,
# clearly labelled as unchecked.
# https://www.thinkbroadband.com/broadband-availability-api
THINKBROADBAND_API_KEY=

# Only change these if thinkbroadband tell you to — the base URL and path are
# configurable because they publish the specification to licensees only.
THINKBROADBAND_BASE_URL=https://api.thinkbroadband.com
THINKBROADBAND_AVAILABILITY_PATH=/availability
# Set true if your licence keys the query string rather than a header.
THINKBROADBAND_KEY_IN_QUERY=false

# ---- Giacom (formerly Digital Wholesale Solutions) -----------------------
# The second wholesale supplier. Zen answers for Openreach and nothing else;
# Giacom carry BT Wholesale, CityFibre, TalkTalk Business, Virgin Media
# Business and Sky Business, so the same premises can be sellable through both
# accounts at different prices. Their answers merge into the site report as
# separate rows tagged by supplier.
#
# OAuth 2.0 client credentials. Defaults below are Giacom's own published
# production servers, so normally only the credentials are needed.
# https://docs.integrations.giacom.com/
GIACOM_CLIENT_ID=
GIACOM_CLIENT_SECRET=

# `uat` switches both hosts to Giacom's UAT environment, for proving the
# integration before it touches the production account.
GIACOM_ENVIRONMENT=production

# Scopes are granted individually by Giacom, so a working credential can still
# be refused one of them. The admin board probes each separately. Trim this
# list to what your tenant actually has.
GIACOM_SCOPES=integrations/serviceInventory.read,integrations/serviceCatalogue.read,integrations/resourceInventory.read,integrations/address.manage,integrations/serviceQualification.read,integrations/serviceQualification.submit

# TMF645 ServiceQualification — the per-address serviceability check.
#
# LEAVE THIS BLANK until Giacom confirm the path. The scope is in their
# published OAuth list but no path for it appears in their public OpenAPI
# document, so it is documented per tenant. Guessing it would produce
# confident 404s that look like "no coverage", which is the worst possible
# failure for this screen. Until it is set, the integration reads the service
# inventory and catalogue only and never claims availability.
GIACOM_QUALIFICATION_PATH=

# Only override these if Giacom tell you to.
GIACOM_BASE_URL=
GIACOM_TOKEN_URL=
