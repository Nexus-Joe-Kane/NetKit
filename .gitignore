node_modules/
dist/
build/
.env
.env.local
# Removed deliberately: the variable list is generated as
# PLESK-ENVIRONMENT-VARIABLES.txt, and a tracked template next to a real
# .env is how a live session secret and the admin password ended up
# committed on the server.
.env.example
*.log
.DS_Store
# Test coverage output. Anchored to the repo root and the workspace roots
# on purpose: an unanchored `coverage/` also swallowed
# `server/src/providers/coverage/`, which is source.
/coverage/
/*/coverage/
.vite/
*.tsbuildinfo
dist-test/
data/
backups/

# Build output — regenerated by `npm run build` on deploy
/public/
/tmp/
.data-dev
