PUBLIC_BASE_URL=https://hottub.joekane.org
SOURCE_NAME=Joe's Unified Hot Tub Source

# Required to access any route, including the Hot Tub API.
# Comma-separated exact egress IPs. Production allows Joe's two VPN servers.
ADMIN_ALLOWED_IPS=92.71.54.161,177.7.57.50

# Optional until an authorised provider connection exists.
# Comma-separated key_id:base64url_32_byte_key entries; first key encrypts,
# all keys can decrypt. Example key generation:
# node -e "console.log(Buffer.from(crypto.getRandomValues(new Uint8Array(32))).toString('base64url'))"
TOKEN_ENCRYPTION_KEYS=2026-01:replace-with-a-base64url-encoded-32-byte-key
